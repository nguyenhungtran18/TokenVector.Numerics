<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <LangVersion>12</LangVersion>
    <RootNamespace>TokenVector.Numerics</RootNamespace>
    <AssemblyName>TokenVector.Numerics</AssemblyName>
    <Version>1.0.1</Version>
    <PackageId>TokenVector.Numerics</PackageId>
    <Title>TokenVector.Numerics - Enterprise Tensor &amp; Mathematical Super-Library</Title>
    <Description>Ultra high-performance tensor computing, linear algebra, optimization, signal processing, quantum computing, astrodynamics, and computational physics runtime engine for TokenVector.</Description>
    <Authors>TokenVector Project Team</Authors>
    <Company>TokenVector</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tensor;numerics;matrix;linalg;optimization;fft;signal;statistics;quantum;astrodynamics;finance;physics;simd;tokenvector</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/nguyenhungtran18/TokenVector.Numerics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

# TV-1001: TokenVector (`.tkv`) translation of the TokenVector.Numerics **LinAlg** module (part 2).
# Source of truth (reference implementations, 1:1 sections):
#   LinAlg/MatrixFunctions -> expm, sqrtm, solve_sylvester_cm
#   LinAlg/LinAlgExtended -> pinv, matrix_rank, lstsq, cond, solve_band_tridiagonal, null_space, kronecker_sum
#   LinAlg/Complex -> class Complex (generic complex pair for DSP/FFT)
#
# Fidelity notes:
#   - Padé (6,6) coefficients of `expm` are kept bit-for-bit:
#     c = [1, 1/2, 5/44, 1/66, 1/792, 1/15840, 1/665280].
#   - Denman-Beavers iteration (sqrtm), Thomas algorithm (solve_band_tridiagonal),
#     and the Moore-Penrose construction (pinv) mirror the control flow 1:1.
#   - operator overloads (`+`, `-`, `*` on NDArray) become explicit helpers
#     (_mat_add, _mat_sub, _mat_scale) because TV-1001 stdlib modules use
#     module-level functions.

import tv
from tv.core import NDArray, eye_rc
from tv.linalg import matmul, kron, solve, inverse, norm, svd

def _zeros(shape, dtype="f64"):
    return NDArray(shape, dtype=dtype)

def _eye(n):
    return eye_rc(n, n)

def _abs(v):
    if v < 0.0:
        return -v
    return v

def _mat_add(a, b):
    result = _zeros(a.shape)
    for i in range(result.total_length):
        result.buffer.data[result.offset + i] = a.buffer.data[a.offset + i] + b.buffer.data[b.offset + i]
    return result

def _mat_sub(a, b):
    result = _zeros(a.shape)
    for i in range(result.total_length):
        result.buffer.data[result.offset + i] = a.buffer.data[a.offset + i] - b.buffer.data[b.offset + i]
    return result

def _mat_scale(a, scalar):
    result = _zeros(a.shape)
    for i in range(result.total_length):
        result.buffer.data[result.offset + i] = a.buffer.data[a.offset + i] * scalar
    return result

# ---------------------------------------------------------------------------
# MatrixFunctions  (LinAlg/MatrixFunctions
# ---------------------------------------------------------------------------

def expm(a):
    # Matrix exponential e^A via (6,6) Pade + scaling-and-squaring.
    if a.rank() != 2 or a.shape[0] != a.shape[1]:
        raise ValueError("Expm requires a square matrix")
    n = a.shape[0]
    norm_a = norm(a, "inf")
    s = 0
    if norm_a > 0.5:
        s = _ceil_log2(norm_a / 0.5)
        if s < 0:
            s = 0
    scale = _pow2(s)
    a_scaled = _mat_scale(a, 1.0 / scale)

    c = [1.0, 0.5, 5.0 / 44.0, 1.0 / 66.0, 1.0 / 792.0, 1.0 / 15840.0, 1.0 / 665280.0]

    i_mat = _eye(n)
    a2 = matmul(a_scaled, a_scaled)
    a4 = matmul(a2, a2)
    a6 = matmul(a4, a2)

    u_inner = _mat_add(_mat_add(_mat_scale(i_mat, c[1]), _mat_scale(a2, c[3])), _mat_scale(a4, c[5]))
    u = matmul(a_scaled, u_inner)
    v = _mat_add(_mat_add(_mat_add(_mat_scale(i_mat, c[0]), _mat_scale(a2, c[2])), _mat_scale(a4, c[4])), _mat_scale(a6, c[6]))

    num = _mat_add(v, u)
    den = _mat_sub(v, u)
    den_inv = inverse(den)
    r = matmul(den_inv, num)

    for step in range(s):
        r = matmul(r, r)
    return r

def _ceil_log2(x):
    # Smallest integer s with 2^s >= x (mirrors Math.Ceiling(Math.Log2(x))).
    s = 0
    val = 1.0
    while val < x:
        val = val * 2.0
        s = s + 1
    return s

def _pow2(s):
    val = 1.0
    for i in range(s):
        val = val * 2.0
    return val

def sqrtm(a, tol=1e-10, max_iter=50):
    # Principal matrix square root via Denman-Beavers iteration.
    if a.rank() != 2 or a.shape[0] != a.shape[1]:
        raise ValueError("Sqrtm requires a square matrix")
    n = a.shape[0]
    y = a.clone()
    z = _eye(n)
    for iteration in range(max_iter):
        z_inv = inverse(z)
        y_inv = inverse(y)
        next_y = _mat_scale(_mat_add(y, z_inv), 0.5)
        next_z = _mat_scale(_mat_add(z, y_inv), 0.5)
        diff = _mat_sub(next_y, y)
        err = norm(diff, "fro")
        y = next_y
        z = next_z
        if err < tol:
            break
    return y

def solve_sylvester_cm(a, b, c):
    # Sylvester AX + XB = C via Kronecker formulation (MatrixFunctions variant).
    m = a.shape[0]
    n = b.shape[0]
    i_m = _eye(m)
    i_n = _eye(n)
    term1 = kron(i_n, a)
    term2 = kron(b.matrix_transpose(), i_m)
    k_mat = _mat_add(term1, term2)
    vec_c = _zeros([m * n])
    for j in range(n):
        for i in range(m):
            vec_c.buffer.data[vec_c.offset + j * m + i] = c.get([i, j])
    vec_x = solve(k_mat, vec_c)
    x = _zeros([m, n])
    for j in range(n):
        for i in range(m):
            x.set([i, j], vec_x.get([j * m + i]))
    return x

# ---------------------------------------------------------------------------
# LinAlgExtended  (LinAlg/LinAlgExtended
# ---------------------------------------------------------------------------

def pinv(a, rcond=None):
    # Moore-Penrose pseudoinverse via SVD: A^+ = V * Sigma^+ * U^T.
    if a.rank() != 2:
        raise ValueError("PInv requires a 2D matrix")
    u, s, vt = svd_decompose(a)
    m = a.shape[0]
    n = a.shape[1]
    k = s.shape[0]
    max_s = s.get([0])
    if rcond is None:
        cutoff = max_s * _max(m, n) * 1e-15
    else:
        cutoff = rcond
    sigma_plus = _zeros([k, k])
    for i in range(k):
        if s.get([i]) > cutoff:
            sigma_plus.set([i, i], 1.0 / s.get([i]))
    v = vt.matrix_transpose()
    u_t = u.matrix_transpose()
    v_sigma = matmul(v, sigma_plus)
    return matmul(v_sigma, u_t)

def matrix_rank(a, tol=None):
    # Numerical rank of a matrix via SVD.
    if a.rank() != 2:
        raise ValueError("MatrixRank requires a 2D matrix")
    u, s, vt = svd_decompose(a)
    m = a.shape[0]
    n = a.shape[1]
    if tol is None:
        cutoff = s.get([0]) * _max(m, n) * 1e-15
    else:
        cutoff = tol
    rank = 0
    for i in range(s.total_length):
        if s.get([i]) > cutoff:
            rank = rank + 1
    return rank

def lstsq(a, b):
    # Minimum-norm least-squares solution of Ax = b via pseudoinverse.
    pinv_a = pinv(a)
    if b.rank() == 1:
        sol_2d = matmul(pinv_a, b.reshape([b.shape[0], 1]))
        return sol_2d.reshape([a.shape[1]])
    return matmul(pinv_a, b)

def cond(a):
    # 2-norm condition number: kappa(A) = sigma_max / sigma_min.
    u, s, vt = svd_decompose(a)
    max_s = s.get([0])
    min_s = s.get([s.total_length - 1])
    if min_s <= 1e-15:
        raise ValueError("Matrix is singular; condition number is infinite")
    return max_s / min_s

def solve_band_tridiagonal(lower, diag, upper, rhs):
    # Thomas algorithm O(N) tridiagonal solve.
    n = diag.total_length
    c_prime = []
    d_prime = []
    for i in range(n):
        d_prime.append(0.0)
    c_prime.append(upper.get([0]) / diag.get([0]))
    d_prime[0] = rhs.get([0]) / diag.get([0])
    for i in range(1, n - 1):
        m_val = 1.0 / (diag.get([i]) - lower.get([i - 1]) * c_prime[i - 1])
        c_prime.append(upper.get([i]) * m_val)
        d_prime[i] = (rhs.get([i]) - lower.get([i - 1]) * d_prime[i - 1]) * m_val
    d_prime[n - 1] = (rhs.get([n - 1]) - lower.get([n - 2]) * d_prime[n - 2]) / (diag.get([n - 1]) - lower.get([n - 2]) * c_prime[n - 2])
    x = _zeros([n])
    x.buffer.data[x.offset + n - 1] = d_prime[n - 1]
    for i in range(n - 2, -1, -1):
        x.buffer.data[x.offset + i] = d_prime[i] - c_prime[i] * x.get([i + 1])
    return x

def null_space(a, rcond=None):
    # Orthonormal basis for the kernel of A via SVD.
    u, s, vt = svd_decompose(a)
    n = a.shape[1]
    k = s.shape[0]
    max_s = s.get([0])
    if rcond is None:
        cutoff = max_s * _max(a.shape[0], n) * 1e-15
    else:
        cutoff = rcond
    rank = 0
    for i in range(k):
        if s.get([i]) > cutoff:
            rank = rank + 1
    null_dim = n - rank
    if null_dim <= 0:
        return _zeros([n, 0])
    null_basis = _zeros([n, null_dim])
    v = vt.matrix_transpose()
    for col in range(null_dim):
        v_col = rank + col
        for r in range(n):
            if v_col < v.shape[1]:
                null_basis.set([r, col], v.get([r, v_col]))
            else:
                null_basis.set([r, col], 0.0)
    return null_basis

def kronecker_sum(a, b):
    # Kronecker sum: A (+) B = A (x) I_b + I_a (x) B.
    na = a.shape[0]
    nb = b.shape[0]
    ia = _eye(na)
    ib = _eye(nb)
    a_kron_ib = kron(a, ib)
    ia_kron_b = kron(ia, b)
    return _mat_add(a_kron_ib, ia_kron_b)

def _max(a, b):
    if a > b:
        return a
    return b

def svd_decompose(a):
    # Thin alias binding to tv.linalg.svd so both entry names work.
    return svd(a)

# ---------------------------------------------------------------------------
# Complex  (LinAlg/Complex
# ---------------------------------------------------------------------------

class Complex:
    # Lightweight complex pair for DSP, FFT, and tensor mathematics.
    def __init__(self, real, imaginary):
        self.real = real
        self.imaginary = imaginary

    def add(self, other):
        return Complex(self.real + other.real, self.imaginary + other.imaginary)

    def sub(self, other):
        return Complex(self.real - other.real, self.imaginary - other.imaginary)

    def mul(self, other):
        # Full complex multiplication (a+bi)(c+di) = (ac-bd) + (ad+bc)i.
        return Complex(self.real * other.real - self.imaginary * other.imaginary,
                       self.real * other.imaginary + self.imaginary * other.real)

    def mul_scalar(self, scalar):
        return Complex(self.real * scalar, self.imaginary * scalar)

    def div_scalar(self, scalar):
        return Complex(self.real / scalar, self.imaginary / scalar)

    def div(self, other):
        denom = other.real * other.real + other.imaginary * other.imaginary
        return Complex((self.real * other.real + self.imaginary * other.imaginary) / denom,
                       (self.imaginary * other.real - self.real * other.imaginary) / denom)

    def conjugate(self):
        return Complex(self.real, -self.imaginary)

    def magnitude_squared(self):
        return self.real * self.real + self.imaginary * self.imaginary

    def equals(self, other):
        return self.real == other.real and self.imaginary == other.imaginary

    def to_string(self):
        return "(" + str(self.real) + " + " + str(self.imaginary) + "j)"

def complex_zero():
    return Complex(0.0, 0.0)

def complex_one():
    return Complex(1.0, 0.0)

def complex_imaginary_one():
    return Complex(0.0, 1.0)

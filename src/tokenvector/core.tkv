# TV-1001: TokenVector (`.tkv`) translation of the TokenVector.Numerics **Core** module.
# Source of truth (reference implementation, 1:1 sections):
#   Core/ShapeHelper -> shape helpers below
#   Core/TensorBuffer -> class TensorBuffer
#   Core/NDArray -> class NDArray
#   Core/BoolNDArray -> class BoolNDArray
#   Core/ShapeExtensions -> expand/squeeze/at_least_*/ravel
#
# Fidelity notes:
#   - `NDArray` is dtype-dynamic (f32/f64/i32/i64).
#   - Zero-copy semantics (Slice/Permute/BroadcastTo share the parent buffer)
#     are preserved exactly as in the reference implementation.

# ---------------------------------------------------------------------------
# Broadcast shape helpers  (Engine/BroadcastEngine)
# ---------------------------------------------------------------------------

def broadcast_shapes(shape_a: "list[i32]", shape_b: "list[i32]") -> "list[i32]":
    rank_a = len(shape_a)
    rank_b = len(shape_b)
    max_rank = rank_a
    if rank_b > max_rank:
        max_rank = rank_b
    out_shape = []
    for i in range(max_rank):
        out_shape.append(1)
    for i in range(max_rank):
        if i < rank_a:
            dim_a = shape_a[rank_a - 1 - i]
        else:
            dim_a = 1
        if i < rank_b:
            dim_b = shape_b[rank_b - 1 - i]
        else:
            dim_b = 1
        if dim_a == dim_b or dim_a == 1 or dim_b == 1:
            max_dim = dim_a
            if dim_b > max_dim:
                max_dim = dim_b
            out_shape[max_rank - 1 - i] = max_dim
        else:
            raise ValueError("Cannot broadcast shapes with incompatible dimensions")
    return out_shape

def compute_broadcast_strides(source_shape: "list[i32]", source_strides: "list[i32]", target_shape: "list[i32]") -> "list[i32]":
    src_rank = len(source_shape)
    target_rank = len(target_shape)
    broadcast_strides = []
    for i in range(target_rank):
        broadcast_strides.append(0)
    rank_diff = target_rank - src_rank
    for i in range(target_rank):
        if i < rank_diff:
            broadcast_strides[i] = 0
        else:
            src_idx = i - rank_diff
            src_dim = source_shape[src_idx]
            target_dim = target_shape[i]
            if src_dim == target_dim:
                broadcast_strides[i] = source_strides[src_idx]
            elif src_dim == 1:
                broadcast_strides[i] = 0
            else:
                raise ValueError("Incompatible dimension at axis " + str(i))
    return broadcast_strides

# ---------------------------------------------------------------------------
# ShapeHelper  (Core/ShapeHelper)
# ---------------------------------------------------------------------------

def shape_total_length(shape: "list[i32]") -> "i32":
    if len(shape) == 0:
        return 1
    total = 1
    for i in range(len(shape)):
        if shape[i] < 0:
            raise ValueError("Dimension size cannot be negative")
        total = total * shape[i]
    return total

def row_major_strides(shape: "list[i32]") -> "list[i32]":
    if len(shape) == 0:
        return []
    strides = []
    for i in range(len(shape)):
        strides.append(0)
    stride = 1
    for i in range(len(shape) - 1, -1, -1):
        strides[i] = stride
        stride = stride * shape[i]
    return strides

def is_contiguous(shape: "list[i32]", strides: "list[i32]") -> "i32":
    if len(shape) == 0:
        return 1
    expected = 1
    for i in range(len(shape) - 1, -1, -1):
        if shape[i] == 0:
            return 1
        if shape[i] == 1:
            continue
        if strides[i] != expected:
            return 0
        expected = expected * shape[i]
    return 1

def get_flat_index(indices: "list[i32]", strides: "list[i32]", offset: "i32") -> "i32":
    flat = offset
    for i in range(len(indices)):
        flat = flat + indices[i] * strides[i]
    return flat

def get_multi_index(linear_index: "i32", shape: "list[i32]") -> "list[i32]":
    coords = []
    for i in range(len(shape)):
        coords.append(0)
    rem = linear_index
    for i in range(len(shape) - 1, -1, -1):
        dim = shape[i]
        if dim == 0:
            coords[i] = 0
            continue
        coords[i] = rem % dim
        rem = rem // dim
    return coords

def clamp_int(value: "i32", low: "i32", high: "i32") -> "i32":
    if value < low:
        return low
    if value > high:
        return high
    return value

# ---------------------------------------------------------------------------
# TensorBuffer  (Core/TensorBuffer)
# ---------------------------------------------------------------------------

class TensorBuffer:
    data: "list[f64]"
    length: "i32"

    def __init__(self, length, data=None, is_native=False):
        pass

    def add_ref(self):
        pass

    def get(self, index: "i32") -> "f64":
        return self.data[index]

    def set(self, index: "i32", value: "f64"):
        self.data[index] = value

    def to_list(self, offset: "i32" = 0, length: "i32" = -1) -> "list[f64]":
        if length < 0:
            length = self.length - offset
        out = []
        for i in range(length):
            out.append(self.data[offset + i])
        return out

    def clone(self) -> "TensorBuffer":
        buf = TensorBuffer(self.length)
        for i in range(self.length):
            buf.data.append(self.data[i])
        return buf

    def dispose(self):
        pass

def make_buffer_from_list(values: "list[f64]") -> "TensorBuffer":
    buf = TensorBuffer(len(values))
    for i in range(len(values)):
        buf.data.append(values[i])
    return buf

def make_native_buffer(length: "i32") -> "TensorBuffer":
    buf = TensorBuffer(length)
    for i in range(length):
        buf.data.append(0.0)
    return buf

# ---------------------------------------------------------------------------
# NDArray  (Core/NDArray)
# ---------------------------------------------------------------------------

class NDArray:
    shape: "list[i32]"
    strides: "list[i32]"
    buffer: "TensorBuffer"
    offset: "i32"
    total_length: "i32"
    is_contiguous: "i32"
    dtype: "str"

    def __init__(self, shape, buffer=None, strides=None, offset=0, dtype="f64"):
        pass

    def rank(self) -> "i32":
        return len(self.shape)

    def get(self, coords: "list[i32]") -> "f64":
        if len(coords) != len(self.shape):
            raise ValueError("Index rank does not match tensor rank")
        flat = self.offset
        for i in range(len(coords)):
            c = coords[i]
            if c < 0 or c >= self.shape[i]:
                raise IndexError("Index out of range")
            flat = flat + c * self.strides[i]
        return self.buffer.get(flat)

    def set(self, coords: "list[i32]", value: "f64"):
        if len(coords) != len(self.shape):
            raise ValueError("Index rank does not match tensor rank")
        flat = self.offset
        for i in range(len(coords)):
            c = coords[i]
            if c < 0 or c >= self.shape[i]:
                raise IndexError("Index out of range")
            flat = flat + c * self.strides[i]
        self.buffer.set(flat, value)

    def get_flat(self, index: "i32") -> "f64":
        if index < 0 or index >= self.total_length:
            raise IndexError("Index out of range")
        if self.is_contiguous != 0 and self.offset == 0:
            return self.buffer.get(index)
        return self.get(get_multi_index(index, self.shape))

    def set_flat(self, index: "i32", value: "f64"):
        if index < 0 or index >= self.total_length:
            raise IndexError("Index out of range")
        if self.is_contiguous != 0 and self.offset == 0:
            self.buffer.set(index, value)
            return
        self.set(get_multi_index(index, self.shape), value)

    def slice(self, ranges: "list[list[i32]]") -> "NDArray":
        if len(ranges) > len(self.shape):
            raise ValueError("Too many slice dimensions specified")
        new_shape = []
        new_strides = []
        new_offset = self.offset
        for i in range(len(self.shape)):
            dim = self.shape[i]
            stride = self.strides[i]
            if i >= len(ranges):
                new_shape.append(dim)
                new_strides.append(stride)
                continue
            r_item = ranges[i]
            start = r_item[0]
            stop = r_item[1]
            step = r_item[2]
            if step == 0:
                raise ValueError("Slice step cannot be zero")
            if start < 0:
                start = dim + start
                if start < 0:
                    start = 0
            if stop < 0:
                stop = dim + stop
                if stop < 0:
                    stop = 0
            start = clamp_int(start, 0, dim)
            stop = clamp_int(stop, 0, dim)
            if step > 0:
                new_strides.append(stride * step)
                if start >= stop:
                    new_shape.append(0)
                else:
                    new_shape.append((stop - start + step - 1) // step)
                    new_offset = new_offset + start * stride
            else:
                new_strides.append(stride * step)
                if start <= stop:
                    new_shape.append(0)
                else:
                    new_shape.append((start - stop - step - 1) // (-step))
                    new_offset = new_offset + start * stride
        return _make_ndarray(new_shape, self.buffer, new_strides, new_offset, self.dtype)

    def permute(self, axes: "list[i32]") -> "NDArray":
        if len(axes) != len(self.shape):
            raise ValueError("Number of axes in permutation must match tensor rank")
        visited = []
        for i in range(len(self.shape)):
            visited.append(0)
        new_shape = []
        new_strides = []
        for i in range(len(axes)):
            axis = axes[i]
            if axis < 0 or axis >= len(self.shape) or visited[axis] != 0:
                raise ValueError("Invalid or duplicate axis in permutation")
            visited[axis] = 1
            new_shape.append(self.shape[axis])
            new_strides.append(self.strides[axis])
        return _make_ndarray(new_shape, self.buffer, new_strides, self.offset, self.dtype)

    def transpose(self, axis0: "i32" = 0, axis1: "i32" = 1) -> "NDArray":
        axes = []
        for i in range(self.rank()):
            axes.append(i)
        tmp = axes[axis0]
        axes[axis0] = axes[axis1]
        axes[axis1] = tmp
        return self.permute(axes)

    def matrix_transpose(self) -> "NDArray":
        if self.rank() < 2:
            return self
        return self.transpose(self.rank() - 2, self.rank() - 1)

    def reshape(self, new_shape: "list[i32]") -> "NDArray":
        new_total = shape_total_length(new_shape)
        if new_total != self.total_length:
            raise ValueError("Cannot reshape: total size mismatch")
        if self.is_contiguous != 0:
            return _make_ndarray(new_shape, self.buffer, row_major_strides(new_shape), self.offset, self.dtype)
        contig = self.contiguous()
        return contig.reshape(new_shape)

    def contiguous(self) -> "NDArray":
        if self.is_contiguous != 0 and self.offset == 0 and self.buffer.length == self.total_length:
            return self
        result = zeros(self.shape, self.dtype)
        res_buf = result.buffer
        if self.rank() == 1:
            for i in range(self.total_length):
                res_buf.data[i] = self.buffer.get(self.offset + i * self.strides[0])
        else:
            for i in range(self.total_length):
                res_buf.data[i] = self.get(get_multi_index(i, self.shape))
        return result

    def broadcast_to(self, target_shape: "list[i32]") -> "NDArray":
        strides = compute_broadcast_strides(self.shape, self.strides, target_shape)
        return _make_ndarray(target_shape, self.buffer, strides, self.offset, self.dtype)

    def clone(self) -> "NDArray":
        contig = self.contiguous()
        clone_buffer = contig.buffer.clone()
        return _make_ndarray(self.shape, clone_buffer, row_major_strides(self.shape), 0, self.dtype)

    def as_list(self) -> "list[f64]":
        if self.is_contiguous == 0:
            raise ValueError("as_list() requires a contiguous tensor; call contiguous() first")
        return self.buffer.to_list(self.offset, self.total_length)

    def to_list(self) -> "list[f64]":
        out = []
        for i in range(self.total_length):
            out.append(self.get_flat(i))
        return out

    def to_string(self) -> "str":
        parts = "NDArray(shape=["
        for i in range(len(self.shape)):
            if i > 0:
                parts = parts + ", "
            parts = parts + str(self.shape[i])
        parts = parts + "], dtype=" + self.dtype + "): ["
        count = self.total_length
        if count > 100:
            count = 100
        for i in range(count):
            if i > 0:
                parts = parts + ", "
            parts = parts + str(self.get_flat(i))
        if self.total_length > 100:
            parts = parts + ", ..."
        parts = parts + "]"
        return parts

    def dispose(self):
        pass

def _make_ndarray(shape: "list[i32]", buffer: "TensorBuffer", strides: "list[i32]", offset: "i32", dtype: "str") -> "NDArray":
    tot = shape_total_length(shape)
    contig = is_contiguous(shape, strides)
    arr = NDArray(buffer, offset, tot, contig, dtype)
    for i in range(len(shape)):
        arr.shape.append(shape[i])
    for i in range(len(strides)):
        arr.strides.append(strides[i])
    return arr

# -- Factory functions -------------------------------------------------------

def zeros(shape: "list[i32]", dtype: "str" = "f64") -> "NDArray":
    tot = shape_total_length(shape)
    buf = make_native_buffer(tot)
    strides = row_major_strides(shape)
    return _make_ndarray(shape, buf, strides, 0, dtype)

def ones(shape: "list[i32]", dtype: "str" = "f64") -> "NDArray":
    result = zeros(shape, dtype)
    fill(result, 1.0)
    return result

def full(value: "f64", shape: "list[i32]", dtype: "str" = "f64") -> "NDArray":
    result = zeros(shape, dtype)
    fill(result, value)
    return result

def fill(arr: "NDArray", value: "f64") -> "NDArray":
    arr_buf = arr.buffer
    for i in range(arr.total_length):
        arr_buf.data[arr.offset + i] = value
    return arr

def eye(size: "i32", dtype: "str" = "f64") -> "NDArray":
    return eye_rc(size, size, dtype=dtype)

def eye_rc(rows: "i32", cols: "i32", dtype: "str" = "f64") -> "NDArray":
    shape = [rows, cols]
    result = zeros(shape, dtype)
    n = rows
    if cols < n:
        n = cols
    for i in range(n):
        result.set([i, i], 1.0)
    return result

def arange(start: "f64", stop: "f64", step: "f64") -> "NDArray":
    if step == 0.0:
        raise ValueError("Step cannot be zero")
    values = []
    v = start
    if step > 0.0:
        while v < stop:
            values.append(v)
            v = v + step
    else:
        while v > stop:
            values.append(v)
            v = v + step
    return from_array(values, [len(values)])

def linspace(start: "f64", stop: "f64", num: "i32") -> "NDArray":
    if num <= 0:
        raise ValueError("num must be positive")
    if num == 1:
        return from_array([start], [1])
    values = []
    step = (stop - start) / (num - 1.0)
    for i in range(num):
        values.append(start + i * step)
    return from_array(values, [num])

def from_array(values: "list[f64]", shape: "list[i32]") -> "NDArray":
    total = shape_total_length(shape)
    if len(values) != total:
        raise ValueError("Array length does not match shape total size")
    buf = make_buffer_from_list(values)
    strides = row_major_strides(shape)
    return _make_ndarray(shape, buf, strides, 0, "f64")

def allocate_native(shape: "list[i32]", dtype: "str" = "f64") -> "NDArray":
    tot = shape_total_length(shape)
    buffer = make_native_buffer(tot)
    strides = row_major_strides(shape)
    return _make_ndarray(shape, buffer, strides, 0, dtype)

# ---------------------------------------------------------------------------
# BoolNDArray  (Core/BoolNDArray)
# ---------------------------------------------------------------------------

class BoolNDArray:
    shape: "list[i32]"
    strides: "list[i32]"
    buffer: "list[i32]"
    offset: "i32"
    total_length: "i32"

    def __init__(self, shape):
        pass

    def get(self, coords: "list[i32]") -> "i32":
        flat = self.offset
        for i in range(len(coords)):
            flat = flat + coords[i] * self.strides[i]
        return self.buffer[flat]

    def set(self, coords: "list[i32]", value: "i32"):
        flat = self.offset
        for i in range(len(coords)):
            flat = flat + coords[i] * self.strides[i]
        self.buffer[flat] = value

    def to_list(self) -> "list[i32]":
        out = []
        for i in range(self.total_length):
            out.append(self.buffer[self.offset + i])
        return out

    def logical_and(self, other: "BoolNDArray") -> "BoolNDArray":
        return bool_logical_op(self, other, "and")

    def logical_or(self, other: "BoolNDArray") -> "BoolNDArray":
        return bool_logical_op(self, other, "or")

    def logical_not(self) -> "BoolNDArray":
        result = make_bool_ndarray(self.shape)
        res_buf = result.buffer
        for i in range(self.total_length):
            val = self.buffer[self.offset + i]
            not_val = 1
            if val != 0:
                not_val = 0
            res_buf[i] = not_val
        return result

    def to_string(self) -> "str":
        return "BoolNDArray(count=" + str(self.total_length) + ")"

def make_bool_ndarray(shape: "list[i32]") -> "BoolNDArray":
    tot = shape_total_length(shape)
    strides = row_major_strides(shape)
    arr = BoolNDArray(0, tot)
    for i in range(len(shape)):
        arr.shape.append(shape[i])
    for i in range(len(strides)):
        arr.strides.append(strides[i])
    for i in range(tot):
        arr.buffer.append(0)
    return arr

def bool_logical_op(a: "BoolNDArray", b: "BoolNDArray", op: "str") -> "BoolNDArray":
    out_shape = broadcast_shapes(a.shape, b.shape)
    res = make_bool_ndarray(out_shape)
    res_buf = res.buffer
    for i in range(res.total_length):
        coords = get_multi_index(i, out_shape)
        va = a.get(coords)
        vb = b.get(coords)
        out_v = 0
        if op == "and":
            if va != 0 and vb != 0:
                out_v = 1
        else:
            if va != 0 or vb != 0:
                out_v = 1
        res_buf[i] = out_v
    return res

# ---------------------------------------------------------------------------
# ShapeExtensions  (Core/ShapeExtensions)
# ---------------------------------------------------------------------------

def expand_dims(arr: "NDArray", axis: "i32") -> "NDArray":
    rank = arr.rank()
    if axis < 0:
        axis = axis + rank + 1
    if axis < 0 or axis > rank:
        raise ValueError("Axis out of range for expand_dims")
    new_shape = []
    src = 0
    for i in range(rank + 1):
        if i == axis:
            new_shape.append(1)
        else:
            new_shape.append(arr.shape[src])
            src = src + 1
    return arr.reshape(new_shape)

def squeeze(arr: "NDArray", axis: "i32" = -999999) -> "NDArray":
    if axis != -999999:
        if axis < 0:
            axis = axis + arr.rank()
        if axis < 0 or axis >= arr.rank():
            raise ValueError("Axis out of range for squeeze")
        if arr.shape[axis] != 1:
            raise ValueError("Cannot squeeze dimension of size != 1")
        new_shape = []
        for i in range(arr.rank()):
            if i != axis:
                new_shape.append(arr.shape[i])
        if len(new_shape) == 0:
            new_shape = [1]
        return arr.reshape(new_shape)
    new_shape = []
    for i in range(arr.rank()):
        if arr.shape[i] != 1:
            new_shape.append(arr.shape[i])
    if len(new_shape) == 0:
        new_shape = [1]
    return arr.reshape(new_shape)

def at_least_1d(arr: "NDArray") -> "NDArray":
    if arr.rank() >= 1:
        return arr
    return arr.reshape([1])

def at_least_2d(arr: "NDArray") -> "NDArray":
    if arr.rank() >= 2:
        return arr
    if arr.rank() == 1:
        return arr.reshape([1, arr.shape[0]])
    return arr.reshape([1, 1])

def at_least_3d(arr: "NDArray") -> "NDArray":
    if arr.rank() >= 3:
        return arr
    if arr.rank() == 2:
        return arr.reshape([1, arr.shape[0], arr.shape[1]])
    if arr.rank() == 1:
        return arr.reshape([1, arr.shape[0], 1])
    return arr.reshape([1, 1, 1])

def unravel_index(flat_index: "i32", shape: "list[i32]") -> "list[i32]":
    coords = []
    for d in range(len(shape)):
        coords.append(0)
    rem = flat_index
    for d in range(len(shape) - 1, -1, -1):
        coords[d] = rem % shape[d]
        rem = rem // shape[d]
    return coords

def ravel_multi_index(coords: "list[i32]", shape: "list[i32]") -> "i32":
    flat = 0
    stride = 1
    for d in range(len(shape) - 1, -1, -1):
        flat = flat + coords[d] * stride
        stride = stride * shape[d]
    return flat

# ---------------------------------------------------------------------------
# NumPy-parity gap fill
# ---------------------------------------------------------------------------

def empty(shape: "list[i32]", dtype: "str" = "f64") -> "NDArray":
    return zeros(shape, dtype)

def logspace(start: "f64", stop: "f64", num: "i32" = 50, base: "f64" = 10.0) -> "NDArray":
    lin = linspace(start, stop, num)
    result = zeros([num], "f64")
    res_buf = result.buffer
    for i in range(num):
        e = lin.get_flat(i)
        res_buf.data[result.offset + i] = exp(e * log(base))
    return result

def geomspace(start: "f64", stop: "f64", num: "i32" = 50) -> "NDArray":
    if start == 0.0 or stop == 0.0 or (start < 0.0) != (stop < 0.0):
        raise ValueError("geomspace requires non-zero endpoints of the same sign")
    log_start = log(_abs_c(start))
    log_stop = log(_abs_c(stop))
    result = zeros([num], "f64")
    res_buf = result.buffer
    for i in range(num):
        t = 0.0
        if num > 1:
            t = i / (num - 1.0)
        magnitude = exp(log_start + t * (log_stop - log_start))
        if start > 0.0:
            res_buf.data[result.offset + i] = magnitude
        else:
            res_buf.data[result.offset + i] = -magnitude
    return result

def _abs_c(v: "f64") -> "f64":
    if v < 0.0:
        return -v
    return v

def ndim(arr: "NDArray") -> "i32":
    return arr.rank()

def size(arr: "NDArray") -> "i32":
    return arr.total_length

def ravel(arr: "NDArray") -> "NDArray":
    contig = arr.contiguous()
    return contig.reshape([arr.total_length])

def copy(arr: "NDArray") -> "NDArray":
    return arr.clone()

def astype(arr: "NDArray", dtype: "str") -> "NDArray":
    contig = arr.contiguous()
    clone_buffer = contig.buffer.clone()
    return _make_ndarray(contig.shape, clone_buffer, row_major_strides(contig.shape), 0, dtype)

def ptp(arr: "NDArray", axis: "i32" = -999999) -> "f64":
    lo = arr.get_flat(0)
    hi = arr.get_flat(0)
    for i in range(1, arr.total_length):
        v = arr.get_flat(i)
        if v < lo:
            lo = v
        if v > hi:
            hi = v
    return hi - lo

def choose(indices_arr: "NDArray", choices: "list[NDArray]") -> "NDArray":
    n_choices = len(choices)
    first_choice = choices[0]
    result = zeros(indices_arr.shape, first_choice.dtype)
    res_buf = result.buffer
    for i in range(indices_arr.total_length):
        k = int(indices_arr.get_flat(i))
        if k < 0 or k >= n_choices:
            raise ValueError("choose index out of the choice list")
        choice_k = choices[k]
        res_buf.data[result.offset + i] = choice_k.get_flat(i)
    return result

def real(arr: "NDArray") -> "NDArray":
    if arr.rank() == 2 and arr.shape[1] == 2:
        n = arr.shape[0]
        result = zeros([n], arr.dtype)
        res_buf = result.buffer
        for i in range(n):
            res_buf.data[result.offset + i] = arr.get([i, 0])
        return result
    return arr.clone()

def imag(arr: "NDArray") -> "NDArray":
    if arr.rank() == 2 and arr.shape[1] == 2:
        n = arr.shape[0]
        result = zeros([n], arr.dtype)
        res_buf = result.buffer
        for i in range(n):
            res_buf.data[result.offset + i] = arr.get([i, 1])
        return result
    return zeros(arr.shape, arr.dtype)

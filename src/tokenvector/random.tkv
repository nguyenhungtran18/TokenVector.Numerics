# TV-1001: TokenVector (`.tkv`) translation of the Random/TensorRandom module.
# Source of truth (reference implementation, 1:1 sections):
#   ManualSeed            -> manual_seed
#   Rand  [0, 1)          -> rand
#   Randn (Box-Muller)    -> randn / randn_std
#   Randint [low, high)   -> randint
#   Shuffle (Fisher-Yates)-> shuffle
#   Choice (with/without replacement) -> choice

import tv
from tv.core import NDArray

# Module-level generator state (mirrors the thread-static RNG).
# TV-1001 note: module-level bindings are single-assignment, so the mutable
# LCG state lives in a one-element list (equivalent to a static field).
_rng_state_box = [0]

def manual_seed(seed):
    # Sets the global seed for reproducible random tensor generation.
    state = seed % 2147483647
    if state <= 0:
        state = state + 2147483646
    _rng_state_box[0] = state

def _next_double():
    # Park-Miller LCG uniform in [0, 1).
    state = _rng_state_box[0]
    if state == 0:
        state = 987654321
    state = (state * 16807) % 2147483647
    _rng_state_box[0] = state
    return (state - 1) / 2147483646.0

def _next_int(low, high):
    # Uniform integer in [low, high).
    span = high - low
    return low + int(_next_double() * span) % span

def _total(shape):
    total = 1
    for i in range(len(shape)):
        total = total * shape[i]
    return total

def rand(shape):
    # Tensor of uniforms in [0, 1).
    result = NDArray(shape)
    for i in range(result.total_length):
        result.buffer.data[result.offset + i] = _next_double()
    return result

def randn(mean=0.0, std=1.0, shape=None):
    # Standard normal tensor N(mean, std^2) via Box-Muller transform.
    if shape is None:
        shape = [1]
    result = NDArray(shape)
    n = result.total_length
    two_pi = 2.0 * 3.14159265358979323846
    i = 0
    while i < n:
        u1 = _next_double()
        if u1 < 1e-15:
            u1 = 1e-15
        u2 = _next_double()
        radius = tv.sqrt(-2.0 * tv.log(u1))
        theta = two_pi * u2
        z0 = radius * tv.cos(theta)
        z1 = radius * tv.sin(theta)
        result.buffer.data[result.offset + i] = mean + z0 * std
        if i + 1 < n:
            result.buffer.data[result.offset + i + 1] = mean + z1 * std
        i = i + 2
    return result

def randn_std(shape):
    # Standard normal tensor N(0, 1).
    return randn(0.0, 1.0, shape)

def randint(low, high, shape):
    # Uniform random integers in [low, high).
    if low >= high:
        raise ValueError("low must be strictly less than high")
    result = NDArray(shape)
    for i in range(result.total_length):
        result.buffer.data[result.offset + i] = _next_int(low, high)
    return result

def shuffle(tensor):
    # Fisher-Yates in-place permutation along axis 0.
    n = tensor.shape[0]
    if tensor.rank() == 1:
        for i in range(n - 1, 0, -1):
            j = _next_int(0, i + 1)
            tmp = tensor.buffer.data[tensor.offset + i]
            tensor.buffer.data[tensor.offset + i] = tensor.buffer.data[tensor.offset + j]
            tensor.buffer.data[tensor.offset + j] = tmp
    else:
        # Swap slices along axis 0
        for i in range(n - 1, 0, -1):
            j = _next_int(0, i + 1)
            if i == j:
                continue
            slice_i = tensor.slice([[i, i + 1, 1]]).contiguous()
            slice_j = tensor.slice([[j, j + 1, 1]]).contiguous()
            for k in range(slice_i.total_length):
                tmp = slice_i.buffer.data[slice_i.offset + k]
                slice_i.buffer.data[slice_i.offset + k] = slice_j.buffer.data[slice_j.offset + k]
                slice_j.buffer.data[slice_j.offset + k] = tmp
    return tensor

def choice(a, size, replace=True):
    # Random sample from a 1D tensor (with or without replacement).
    if a.rank() != 1:
        raise ValueError("Choice requires a 1D tensor")
    if not replace and size > a.total_length:
        raise ValueError("Cannot take a larger sample than population when replace = false")
    result = NDArray([size])
    if replace:
        for i in range(size):
            idx = _next_int(0, a.total_length)
            result.buffer.data[result.offset + i] = a.buffer.data[a.offset + idx]
    else:
        indices = []
        for i in range(a.total_length):
            indices.append(i)
        # Partial Fisher-Yates shuffle
        for i in range(size):
            j = _next_int(i, len(indices))
            tmp = indices[i]
            indices[i] = indices[j]
            indices[j] = tmp
            result.buffer.data[result.offset + i] = a.buffer.data[a.offset + indices[i]]
    return result

# TV-1001: TokenVector (`.tkv`) translation of Science/Astrodynamics.cs.
# Source of truth (C# reference implementation, 1:1 sections):
#   SolveKepler (Newton + Halley step)         -> solve_kepler
#   KeplerianToCartesian (PQW -> ECI rotation) -> keplerian_to_cartesian
#   HohmannTransfer / BiEllipticTransfer       -> hohmann_transfer, bi_elliptic_transfer
#   GeodeticToEcef / EcefToGeodetic (Bowring)  -> geodetic_to_ecef, ecef_to_geodetic
#   J2Perturbation / GibbsOrbitDetermination / ECI_To_ECEF

import tv
from tv.core import NDArray

# Standard Earth Gravitational Parameter mu = GM (km^3 / s^2)
EARTH_MU = 398600.4418
# WGS84 Ellipsoid Constants
WGS84_A = 6378.137                      # semi-major axis in km
WGS84_F = 1.0 / 298.257223563           # flattening
WGS84_B = WGS84_A * (1.0 - WGS84_F)     # semi-minor axis
WGS84_E2 = 2.0 * WGS84_F - WGS84_F * WGS84_F  # first eccentricity squared

_PI = 3.14159265358979323846

def _pow_f(base, exponent):
    return tv.exp(exponent * tv.log(base))

def _abs(v):
    if v < 0.0:
        return -v
    return v

def _vec3(x, y, z):
    result = NDArray([3])
    result.buffer.data[result.offset] = x
    result.buffer.data[result.offset + 1] = y
    result.buffer.data[result.offset + 2] = z
    return result

# ---------------------------------------------------------------------------
# Kepler solver
# ---------------------------------------------------------------------------

def solve_kepler(mean_anomaly, eccentricity, tol=1e-12, max_iter=100):
    # Solves M = E - e*sin(E) for E (Newton-Raphson with Halley correction).
    m = mean_anomaly % (2.0 * _PI)
    if m < -_PI:
        m = m + 2.0 * _PI
    if m > _PI:
        m = m - 2.0 * _PI
    e = eccentricity
    if e < 0.8:
        en = m
    else:
        en = _PI
    for iteration in range(max_iter):
        sin_e = tv.sin(en)
        cos_e = tv.cos(en)
        f = en - e * sin_e - m
        f_prime = 1.0 - e * cos_e
        if _abs(f) < tol:
            return en
        # Halley step
        f_double_prime = e * sin_e
        delta = f / (f_prime - 0.5 * f * f_double_prime / f_prime)
        en = en - delta
        if _abs(delta) < tol:
            break
    return en

# ---------------------------------------------------------------------------
# Orbit propagation
# ---------------------------------------------------------------------------

def keplerian_to_cartesian(a, e, i, raan, omega, nu, mu=EARTH_MU):
    # 6 Keplerian elements -> Cartesian [position, velocity] (km, km/s).
    # Semilatus rectum
    p = a * (1.0 - e * e)
    r_mag = p / (1.0 + e * tv.cos(nu))
    # Position and velocity in Perifocal (PQW) frame
    r_p = r_mag * tv.cos(nu)
    r_q = r_mag * tv.sin(nu)
    sqrt_mu_over_p = tv.sqrt(mu / p)
    v_p = -sqrt_mu_over_p * tv.sin(nu)
    v_q = sqrt_mu_over_p * (e + tv.cos(nu))
    # Rotation from PQW to ECI: R = Rz(-raan) * Rx(-i) * Rz(-omega)
    cos_o = tv.cos(raan)
    sin_o = tv.sin(raan)
    cos_i = tv.cos(i)
    sin_i = tv.sin(i)
    cos_w = tv.cos(omega)
    sin_w = tv.sin(omega)
    p11 = cos_o * cos_w - sin_o * sin_w * cos_i
    p12 = -cos_o * sin_w - sin_o * cos_w * cos_i
    p21 = sin_o * cos_w + cos_o * sin_w * cos_i
    p22 = -sin_o * sin_w + cos_o * cos_w * cos_i
    p31 = sin_w * sin_i
    p32 = cos_w * sin_i
    rx = p11 * r_p + p12 * r_q
    ry = p21 * r_p + p22 * r_q
    rz = p31 * r_p + p32 * r_q
    vx = p11 * v_p + p12 * v_q
    vy = p21 * v_p + p22 * v_q
    vz = p31 * v_p + p32 * v_q
    return [_vec3(rx, ry, rz), _vec3(vx, vy, vz)]

def hohmann_transfer(r1, r2, mu=EARTH_MU):
    # Hohmann transfer -> [delta_v1, delta_v2, total_delta_v, time_of_flight].
    v1 = tv.sqrt(mu / r1)
    v2 = tv.sqrt(mu / r2)
    a_trans = (r1 + r2) / 2.0
    v_trans1 = tv.sqrt(mu * (2.0 / r1 - 1.0 / a_trans))
    v_trans2 = tv.sqrt(mu * (2.0 / r2 - 1.0 / a_trans))
    dv1 = _abs(v_trans1 - v1)
    dv2 = _abs(v2 - v_trans2)
    total_dv = dv1 + dv2
    tof = _PI * tv.sqrt(_pow_f(a_trans, 3) / mu)
    return [dv1, dv2, total_dv, tof]

# ---------------------------------------------------------------------------
# Geodetic coordinates (WGS84)
# ---------------------------------------------------------------------------

def geodetic_to_ecef(lat_deg, lon_deg, alt_km):
    # WGS84 geodetic (lat/lon degrees, altitude km) -> ECEF (X, Y, Z km).
    lat_rad = lat_deg * _PI / 180.0
    lon_rad = lon_deg * _PI / 180.0
    sin_lat = tv.sin(lat_rad)
    cos_lat = tv.cos(lat_rad)
    sin_lon = tv.sin(lon_rad)
    cos_lon = tv.cos(lon_rad)
    n = WGS84_A / tv.sqrt(1.0 - WGS84_E2 * sin_lat * sin_lat)
    x = (n + alt_km) * cos_lat * cos_lon
    y = (n + alt_km) * cos_lat * sin_lon
    z = (n * (1.0 - WGS84_E2) + alt_km) * sin_lat
    return _vec3(x, y, z)

def ecef_to_geodetic(x, y, z):
    # ECEF -> WGS84 geodetic via Bowring's method -> [lat_deg, lon_deg, alt_km].
    p = tv.sqrt(x * x + y * y)
    theta = tv.atan2(z * WGS84_A, p * WGS84_B)
    e_prime2 = (WGS84_A * WGS84_A - WGS84_B * WGS84_B) / (WGS84_B * WGS84_B)
    lat = tv.atan2(
        z + e_prime2 * WGS84_B * _pow_f(tv.sin(theta), 3),
        p - WGS84_E2 * WGS84_A * _pow_f(tv.cos(theta), 3)
    )
    lon = tv.atan2(y, x)
    sin_lat = tv.sin(lat)
    cos_lat = tv.cos(lat)
    n = WGS84_A / tv.sqrt(1.0 - WGS84_E2 * sin_lat * sin_lat)
    alt = p / cos_lat - n
    return [lat * 180.0 / _PI, lon * 180.0 / _PI, alt]

# ---------------------------------------------------------------------------
# Advanced Astrodynamics (Lambert, Gibbs, Bi-Elliptic, J2)
# ---------------------------------------------------------------------------

def j2_perturbation(r, mu=EARTH_MU, re=WGS84_A):
    # J2 gravitational perturbation acceleration step (J2 = 1.08263e-3).
    j2 = 1.08263e-3
    x = r.buffer.data[r.offset]
    y = r.buffer.data[r.offset + 1]
    z = r.buffer.data[r.offset + 2]
    r_mag = tv.sqrt(x * x + y * y + z * z)
    r_sq = r_mag * r_mag
    z_sq = z * z
    factor = (1.5 * j2 * mu * re * re) / _pow_f(r_mag, 5)
    ax = factor * x * (5.0 * z_sq / r_sq - 1.0)
    ay = factor * y * (5.0 * z_sq / r_sq - 1.0)
    az = factor * z * (5.0 * z_sq / r_sq - 3.0)
    return _vec3(ax, ay, az)

def bi_elliptic_transfer(r1, r_b, r2, mu=EARTH_MU):
    # Bi-elliptic transfer -> [dv1, dv2, dv3, total_dv].
    v1 = tv.sqrt(mu / r1)
    v2 = tv.sqrt(mu / r2)
    a1 = (r1 + r_b) / 2.0
    a2 = (r_b + r2) / 2.0
    v_a1 = tv.sqrt(mu * (2.0 / r1 - 1.0 / a1))
    v_b1 = tv.sqrt(mu * (2.0 / r_b - 1.0 / a1))
    v_b2 = tv.sqrt(mu * (2.0 / r_b - 1.0 / a2))
    v_a2 = tv.sqrt(mu * (2.0 / r2 - 1.0 / a2))
    dv1 = _abs(v_a1 - v1)
    dv2 = _abs(v_b2 - v_b1)
    dv3 = _abs(v2 - v_a2)
    return [dv1, dv2, dv3, dv1 + dv2 + dv3]

def _cross(a, b):
    ax = a.buffer.data[a.offset]
    ay = a.buffer.data[a.offset + 1]
    az = a.buffer.data[a.offset + 2]
    bx = b.buffer.data[b.offset]
    by = b.buffer.data[b.offset + 1]
    bz = b.buffer.data[b.offset + 2]
    return [ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx]

def _vec3_magnitude(v):
    # Euclidean length of a 3-vector NDArray (C# local function LocalMagnitude).
    x = v.buffer.data[v.offset]
    y = v.buffer.data[v.offset + 1]
    z = v.buffer.data[v.offset + 2]
    return tv.sqrt(x * x + y * y + z * z)

def gibbs_orbit_determination(r1, r2, r3, mu=EARTH_MU):
    # Gibbs method: velocity v2 at r2 from 3 coplanar position vectors.
    # TV-1001 note: the C# local function LocalMagnitude is hoisted to the
    # module-level helper `_vec3_magnitude` (TV has no nested defs).
    r1_mag = _vec3_magnitude(r1)
    r2_mag = _vec3_magnitude(r2)
    r3_mag = _vec3_magnitude(r3)
    c12 = _cross(r1, r2)
    c23 = _cross(r2, r3)
    c31 = _cross(r3, r1)
    n_vec = [
        r1_mag * c23[0] + r2_mag * c31[0] + r3_mag * c12[0],
        r1_mag * c23[1] + r2_mag * c31[1] + r3_mag * c12[1],
        r1_mag * c23[2] + r2_mag * c31[2] + r3_mag * c12[2],
    ]
    d_vec = [c12[0] + c23[0] + c31[0], c12[1] + c23[1] + c31[1], c12[2] + c23[2] + c31[2]]
    n_mag = tv.sqrt(n_vec[0] * n_vec[0] + n_vec[1] * n_vec[1] + n_vec[2] * n_vec[2])
    d_mag = tv.sqrt(d_vec[0] * d_vec[0] + d_vec[1] * d_vec[1] + d_vec[2] * d_vec[2])
    r2x = r2.buffer.data[r2.offset]
    r2y = r2.buffer.data[r2.offset + 1]
    r2z = r2.buffer.data[r2.offset + 2]
    d_cross_r2 = [
        d_vec[1] * r2z - d_vec[2] * r2y,
        d_vec[2] * r2x - d_vec[0] * r2z,
        d_vec[0] * r2y - d_vec[1] * r2x,
    ]
    factor = tv.sqrt(mu / (n_mag * d_mag))
    v2 = [
        factor * ((d_cross_r2[0] / r2_mag) + (r2x * (n_vec[0] / n_mag))),
        factor * ((d_cross_r2[1] / r2_mag) + (r2y * (n_vec[1] / n_mag))),
        factor * ((d_cross_r2[2] / r2_mag) + (r2z * (n_vec[2] / n_mag))),
    ]
    return _vec3(v2[0], v2[1], v2[2])

def eci_to_ecef(r_eci, gmst_rad):
    # ECI (J2000) position -> ECEF (ITRF) given GMST in radians.
    cos_g = tv.cos(gmst_rad)
    sin_g = tv.sin(gmst_rad)
    x = cos_g * r_eci.buffer.data[r_eci.offset] + sin_g * r_eci.buffer.data[r_eci.offset + 1]
    y = -sin_g * r_eci.buffer.data[r_eci.offset] + cos_g * r_eci.buffer.data[r_eci.offset + 1]
    z = r_eci.buffer.data[r_eci.offset + 2]
    return _vec3(x, y, z)

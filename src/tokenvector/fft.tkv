# TV-1001: TokenVector (`.tkv`) translation of LinAlg/FFT.cs (part 3).
# Source of truth (C# reference implementation, 1:1 sections):
#   FFT1D / IFFT1D / FFT2D / IFFT2D / RFFT1D / IRFFT1D
#   FFTRadix2 / FFTBluestein (chirp-z) / BitReverse
#
# Fidelity notes:
#   - Power-of-two lengths take the Cooley-Tukey Radix-2 path; arbitrary
#     lengths take Bluestein's chirp-z convolution path, exactly as C#.
#   - Parallel.For row/column loops collapse to sequential loops (restored by
#     `tkvc -O parallel`).

import tv
from tv.core import NDArray
from tv.linalg_functions import Complex

def _c_add(a, b):
    return Complex(a.real + b.real, a.imaginary + b.imaginary)

def _c_sub(a, b):
    return Complex(a.real - b.real, a.imaginary - b.imaginary)

def _c_mul(a, b):
    return Complex(a.real * b.real - a.imaginary * b.imaginary,
                   a.real * b.imaginary + a.imaginary * b.real)

def _c_scale(a, s):
    return Complex(a.real * s, a.imaginary * s)

def _c_conj(a):
    return Complex(a.real, -a.imaginary)

def _cos(x):
    return tv.cos(x)

def _sin(x):
    return tv.sin(x)

def _pow2_int(e):
    v = 1
    for i in range(e):
        v = v * 2
    return v

def fft1d(input_list):
    # 1D FFT for ANY length N: Radix-2 when power of 2, Bluestein otherwise.
    n = len(input_list)
    if n <= 1:
        out = []
        for i in range(n):
            out.append(input_list[i])
        return out
    # Power of two check: (n & (n-1)) == 0
    if (n & (n - 1)) == 0:
        return _fft_radix2(input_list)
    return _fft_bluestein(input_list)

def ifft1d(input_list):
    # 1D inverse FFT via conjugate method for any length N.
    n = len(input_list)
    conj = []
    for i in range(n):
        conj.append(_c_conj(input_list[i]))
    transformed = fft1d(conj)
    factor = 1.0 / n
    for i in range(n):
        transformed[i] = _c_scale(_c_conj(transformed[i]), factor)
    return transformed

def fft2d(input_grid):
    # 2D FFT on a row-major list-of-lists complex grid, arbitrary dimensions.
    rows = len(input_grid)
    cols = len(input_grid[0])
    result = []
    for r in range(rows):
        row = []
        for c in range(cols):
            row.append(input_grid[r][c])
        result.append(row)
    for r in range(rows):
        row_span = []
        for c in range(cols):
            row_span.append(result[r][c])
        row_transformed = fft1d(row_span)
        for c in range(cols):
            result[r][c] = row_transformed[c]
    for c in range(cols):
        col_span = []
        for r in range(rows):
            col_span.append(result[r][c])
        col_transformed = fft1d(col_span)
        for r in range(rows):
            result[r][c] = col_transformed[r]
    return result

def ifft2d(input_grid):
    # 2D inverse FFT for arbitrary dimensions.
    rows = len(input_grid)
    cols = len(input_grid[0])
    conj = []
    for r in range(rows):
        row = []
        for c in range(cols):
            row.append(_c_conj(input_grid[r][c]))
        conj.append(row)
    transformed = fft2d(conj)
    factor = 1.0 / (rows * cols)
    for r in range(rows):
        for c in range(cols):
            transformed[r][c] = _c_scale(_c_conj(transformed[r][c]), factor)
    return transformed

def rfft1d(real_signal):
    # Real-to-complex 1D FFT: returns NDArray of shape [N, 2] (re, im per bin).
    if real_signal.rank() != 1:
        raise ValueError("RFFT1D requires a 1D tensor")
    n = real_signal.shape[0]
    c_input = []
    for i in range(n):
        c_input.append(Complex(real_signal.get([i]), 0.0))
    c_output = fft1d(c_input)
    result = NDArray([n, 2])
    for i in range(n):
        result.set([i, 0], c_output[i].real)
        result.set([i, 1], c_output[i].imaginary)
    return result

def irfft1d(complex_signal):
    # Complex-to-real 1D inverse FFT: [N, 2] -> [N].
    if complex_signal.rank() != 2 or complex_signal.shape[1] != 2:
        raise ValueError("IRFFT1D requires a 2D tensor of shape [N, 2]")
    n = complex_signal.shape[0]
    c_input = []
    for i in range(n):
        c_input.append(Complex(complex_signal.get([i, 0]), complex_signal.get([i, 1])))
    c_output = ifft1d(c_input)
    result = NDArray([n])
    for i in range(n):
        result.buffer.data[result.offset + i] = c_output[i].real
    return result

# ---------------------------------------------------------------------------
# Internal FFT algorithms
# ---------------------------------------------------------------------------

def _fft_radix2(input_list):
    n = len(input_list)
    data = []
    for i in range(n):
        data.append(input_list[i])
    _bit_reverse(data)
    two_pi = 2.0 * 3.14159265358979323846264338327950288
    length = 2
    while length <= n:
        angle = -two_pi / length
        wlen = Complex(_cos(angle), _sin(angle))
        i = 0
        while i < n:
            w = Complex(1.0, 0.0)
            half = length // 2
            for j in range(half):
                u = data[i + j]
                v = _c_mul(data[i + j + half], w)
                data[i + j] = _c_add(u, v)
                data[i + j + half] = _c_sub(u, v)
                w = _c_mul(w, wlen)
            i = i + length
        length = length * 2
    return data

def _fft_bluestein(input_list):
    n = len(input_list)
    # Smallest power of two >= 2*n - 1
    m = 1
    while m < 2 * n - 1:
        m = m * 2
    pi = 3.14159265358979323846264338327950288
    factor = pi / n
    chirp = []
    for i in range(n):
        i_sq = (i * i) % (2 * n)
        angle = -factor * i_sq
        chirp.append(Complex(_cos(angle), _sin(angle)))
    a = []
    for i in range(m):
        a.append(Complex(0.0, 0.0))
    for i in range(n):
        a[i] = _c_mul(input_list[i], chirp[i])
    b = []
    for i in range(m):
        b.append(Complex(0.0, 0.0))
    b[0] = _c_conj(chirp[0])
    for i in range(1, n):
        c_val = _c_conj(chirp[i])
        b[i] = c_val
        b[m - i] = c_val
    f_a = _fft_radix2(a)
    f_b = _fft_radix2(b)
    f_c = []
    for i in range(m):
        f_c.append(_c_mul(f_a[i], f_b[i]))
    conj_f_c = []
    for i in range(m):
        conj_f_c.append(_c_conj(f_c[i]))
    ifft_c = _fft_radix2(conj_f_c)
    m_scale = 1.0 / m
    result = []
    for i in range(n):
        conv_val = _c_scale(_c_conj(ifft_c[i]), m_scale)
        result.append(_c_mul(conv_val, chirp[i]))
    return result

def _bit_reverse(data):
    n = len(data)
    j = 0
    for i in range(n - 1):
        if i < j:
            tmp = data[i]
            data[i] = data[j]
            data[j] = tmp
        k = n // 2
        while k <= j:
            j = j - k
            k = k // 2
        j = j + k

# ---------------------------------------------------------------------------
# NumPy-parity gap fill  (N-D transforms, frequencies, shifts)
# ---------------------------------------------------------------------------

def _is_list_grid(v):
    # Structural test standing in for `isinstance(v, list)`: plain lists carry
    # neither .shape (NDArray) nor .real (Complex leaves) — TV-1001 has no
    # isinstance.
    return getattr(v, "shape", None) is None and getattr(v, "real", None) is None

def fftn(grid):
    # np.fftn: N-D transform = fft1d along every axis of the nested list grid.
    if not _is_list_grid(grid):
        raise ValueError("fftn requires a nested list grid")
    if len(grid) == 0:
        return grid
    if not _is_list_grid(grid[0]):
        return fft1d(grid)
    rows = len(grid)
    step1 = []
    for r in range(rows):
        step1.append(fftn(grid[r]))
    cols = len(step1[0])
    result = []
    for r in range(rows):
        result.append([])
        for c in range(cols):
            result[r].append(step1[r][c])
    for c in range(cols):
        col_span = []
        for r in range(rows):
            col_span.append(result[r][c])
        col_t = fft1d(col_span)
        for r in range(rows):
            result[r][c] = col_t[r]
    return result

def ifftn(grid):
    # np.ifftn via the conjugate method on an N-D grid.
    conj = []
    for r in range(len(grid)):
        row = grid[r]
        if _is_list_grid(row):
            inner = []
            for c in range(len(row)):
                inner.append(_c_conj(row[c]))
            conj.append(inner)
        else:
            conj.append(_c_conj(row))
    transformed = fftn(conj)
    total = _grid_size(grid)
    factor = 1.0 / total
    return _grid_scale_conj(transformed, factor)

def _grid_size(grid):
    # Number of leaves of a (possibly nested) list grid.
    total = 1
    cur = grid
    while _is_list_grid(cur):
        total = total * len(cur)
        if len(cur) == 0:
            return 0
        cur = cur[0]
    return total

def _grid_scale_conj(grid, factor):
    # elementwise conj(x)*factor over a nested grid (in place, returns grid).
    for r in range(len(grid)):
        row = grid[r]
        if _is_list_grid(row):
            _grid_scale_conj(row, factor)
        else:
            grid[r] = _c_scale(_c_conj(row), factor)
    return grid

def rfft2(real_grid):
    # np.rfft2: 2D real FFT -> [rows, cols] complex grid.
    rows = len(real_grid)
    cols = len(real_grid[0])
    c_grid = []
    for r in range(rows):
        row = []
        for c in range(cols):
            row.append(Complex(real_grid[r][c], 0.0))
        c_grid.append(row)
    return fft2d(c_grid)

def irfft2(complex_grid):
    # np.irfft2: 2D inverse complex FFT -> real part grid [rows, cols].
    rows = len(complex_grid)
    cols = len(complex_grid[0])
    inv = ifft2d(complex_grid)
    result = []
    for r in range(rows):
        row = []
        for c in range(cols):
            row.append(inv[r][c].real)
        result.append(row)
    return result

def rfftn(real_grid):
    # np.rfftn: N-D real FFT -> complex nested grid.
    return fftn(_real_to_complex_grid(real_grid))

def irfftn(complex_grid):
    # np.irfftn: N-D inverse complex FFT -> real leaf grid.
    inv = ifftn(complex_grid)
    return _grid_real(inv)

def _real_to_complex_grid(real_grid):
    out = []
    for r in range(len(real_grid)):
        row = real_grid[r]
        if _is_list_grid(row):
            out.append(_real_to_complex_grid(row))
        else:
            out.append(Complex(row, 0.0))
    return out

def _grid_real(grid):
    out = []
    for r in range(len(grid)):
        row = grid[r]
        if _is_list_grid(row):
            out.append(_grid_real(row))
        else:
            out.append(row.real)
    return out

def fftfreq(n, d=1.0):
    # np.fftfreq: [0, 1, ..., n/2-1, -n/2, ..., -1] / (n*d).
    result = NDArray([n])
    half = n // 2
    for i in range(half):
        result.buffer.data[result.offset + i] = i / (n * d)
    for i in range(half, n):
        result.buffer.data[result.offset + i] = (i - n) / (n * d)
    return result

def rfftfreq(n, d=1.0):
    # np.rfftfreq: [0, 1, ..., n//2] / (n*d).
    count = n // 2 + 1
    result = NDArray([count])
    for i in range(count):
        result.buffer.data[result.offset + i] = i / (n * d)
    return result

def fftshift(x, axes=None):
    # np.fftshift: roll zero-frequency to the center (1D NDArray or list).
    if _is_list_grid(x):
        n = len(x)
        half = (n + 1) // 2
        return x[half:] + x[0:half]
    n = x.total_length
    half = (n + 1) // 2
    result = NDArray(x.shape, dtype=x.dtype)
    for i in range(n):
        src = (i + half) % n
        result.buffer.data[result.offset + i] = x.get_flat(src)
    return result

def ifftshift(x, axes=None):
    # np.ifftshift: exact inverse of fftshift.
    if _is_list_grid(x):
        n = len(x)
        half = n // 2
        return x[half:] + x[0:half]
    n = x.total_length
    half = n // 2
    result = NDArray(x.shape, dtype=x.dtype)
    for i in range(n):
        src = (i + half) % n
        result.buffer.data[result.offset + i] = x.get_flat(src)
    return result

def ihfft(real_signal):
    # np.ihfft: conjugated rfft (hermitian input packing).
    spec = rfft1d(real_signal)
    n = spec.shape[0]
    out = []
    for i in range(n):
        out.append(Complex(spec.get([i, 0]), -spec.get([i, 1])))
    return out

def hfft(spec, n=None):
    # np.hfft: hermitian spectrum -> real signal (length n or 2*(K-1)).
    k = spec.shape[0] if hasattr_len(spec) else len(spec)
    if n is None:
        n = 2 * (k - 1)
    full = []
    for i in range(n):
        if i < k:
            if hasattr_len(spec):
                full.append(Complex(spec.get([i, 0]), spec.get([i, 1])))
            else:
                full.append(spec[i])
        else:
            mirror = n - i
            if hasattr_len(spec):
                full.append(Complex(spec.get([mirror, 0]), -spec.get([mirror, 1])))
            else:
                full.append(_c_conj(spec[mirror]))
    inv = ifft1d(full)
    out = NDArray([n])
    for i in range(n):
        out.buffer.data[out.offset + i] = inv[i].real
    return out

def hasattr_len(v):
    # Structural test: NDArray has .shape, a plain list does not.
    return getattr(v, "shape", None) is not None

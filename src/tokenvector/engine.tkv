# TV-1001: TokenVector (`.tkv`) translation of the TokenVector.Numerics **Engine** module.
# Source of truth (reference implementation, 1:1 sections):
#   Engine/BroadcastEngine -> broadcasting below
#   Engine/SIMDKernels -> contiguous kernels below
#
# Fidelity notes:
#   - The AVX2/FMA `Vector256` fast paths and generic `Vector<T>` fallbacks in
#     SIMDKernels are hardware-intrinsic code paths outside the TokenVector
#     language surface (TV-1001 grammar). They collapse to a single scalar
#     semantics loop here; `tkvc -O simd` lowers these loops to the same
#     hardware vector registers when targeting x86_64.
#   - Broadcasting keeps NumPy right-aligned rules and the Stride-0 trick
#     (zero-copy virtual expansion) exactly as in the reference implementation.
#   - `broadcast_shapes` / `compute_broadcast_strides` are hosted in core.tkv so
#     module imports stay acyclic; engine re-exports broadcast_to and broadcast_pair.

from tv.core import NDArray, broadcast_shapes, compute_broadcast_strides

# ---------------------------------------------------------------------------
# BroadcastEngine  (Engine/BroadcastEngine)
# ---------------------------------------------------------------------------

def broadcast_to(source: "NDArray", target_shape: "list[i32]") -> "NDArray":
    # Broadcasts an NDArray to a target shape (zero-copy Stride-0 view).
    strides = compute_broadcast_strides(source.shape, source.strides, target_shape)
    source.buffer.add_ref()
    return NDArray(target_shape, buffer=source.buffer, strides=strides,
                   offset=source.offset, dtype=source.dtype)

def broadcast_pair(a: "NDArray", b: "NDArray") -> "list[NDArray]":
    # Broadcasts two NDArrays to a common output shape; returns [left, right].
    out_shape = broadcast_shapes(a.shape, b.shape)
    left = broadcast_to(a, out_shape)
    right = broadcast_to(b, out_shape)
    return [left, right]

# ---------------------------------------------------------------------------
# SIMDKernels  (Engine/SIMDKernels — contiguous elementwise binary ops)
# ---------------------------------------------------------------------------

def add_contiguous(a: "list[f64]", b: "list[f64]", destination: "list[f64]") -> "list[f64]":
    # destination[i] = a[i] + b[i] (SIMD-lowered by tkvc -O simd).
    length = len(destination)
    for i in range(length):
        destination[i] = a[i] + b[i]
    return destination

def subtract_contiguous(a: "list[f64]", b: "list[f64]", destination: "list[f64]") -> "list[f64]":
    # destination[i] = a[i] - b[i].
    length = len(destination)
    for i in range(length):
        destination[i] = a[i] - b[i]
    return destination

def multiply_contiguous(a: "list[f64]", b: "list[f64]", destination: "list[f64]") -> "list[f64]":
    # destination[i] = a[i] * b[i].
    length = len(destination)
    for i in range(length):
        destination[i] = a[i] * b[i]
    return destination

def divide_contiguous(a: "list[f64]", b: "list[f64]", destination: "list[f64]") -> "list[f64]":
    # destination[i] = a[i] / b[i].
    length = len(destination)
    for i in range(length):
        destination[i] = a[i] / b[i]
    return destination

def sum_contiguous(source: "list[f64]") -> "f64":
    # Vectorized-lane accumulation with scalar tail (Vector256.Sum semantics).
    length = len(source)
    if length == 0:
        return 0.0
    total = 0.0
    for i in range(length):
        total = total + source[i]
    return total
